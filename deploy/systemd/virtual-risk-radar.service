[Unit]
Description=VIRTUAL two-source read-only risk radar
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=virtual-risk
Group=virtual-risk
WorkingDirectory=/opt/virtual-risk-radar/current
Environment=NODE_ENV=production
Environment=PORT=8787
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStart=/usr/local/bin/node --import tsx apps/server/src/index.ts
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/virtual-risk-radar
RuntimeDirectory=virtual-risk-radar
RuntimeDirectoryMode=0700
MemoryMax=1G
TasksMax=256
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=virtual-risk-radar

[Install]
WantedBy=multi-user.target
