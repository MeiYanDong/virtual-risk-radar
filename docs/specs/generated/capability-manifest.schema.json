{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifestId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "evidenceLevel": {
      "type": "string",
      "enum": [
        "PLANNED",
        "REPOSITORY_RECORD",
        "TESTED",
        "HISTORICAL_REFERENCE",
        "HISTORICAL_RECEIPT",
        "VERIFIED_CURRENT",
        "UNKNOWN"
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "claims": {
      "minItems": 11,
      "maxItems": 11,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "transport",
              "discovery",
              "identity",
              "quote",
              "simulation",
              "calldata",
              "sign",
              "broadcast",
              "reconcile",
              "exit",
              "replay"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "UNSUPPORTED",
              "PLANNED",
              "IMPLEMENTED",
              "TESTED",
              "HISTORICAL_RECEIPT",
              "VERIFIED_CURRENT"
            ]
          },
          "access": {
            "type": "string",
            "enum": [
              "READ",
              "PREPARE",
              "WRITE",
              "RECOVER"
            ]
          },
          "adapterId": {
            "type": "string",
            "minLength": 1
          },
          "networks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "capability",
          "level",
          "access",
          "adapterId",
          "networks",
          "limitations",
          "evidenceIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "manifestId",
    "version",
    "evidenceLevel",
    "generatedAt",
    "claims"
  ],
  "additionalProperties": false,
  "$id": "https://virtual-risk.local/schema/capability-manifest.v1.json"
}
