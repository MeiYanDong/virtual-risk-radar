{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "SOURCE",
        "CHAIN_STATE",
        "QUOTE",
        "SIMULATION",
        "TRANSPORT",
        "RECEIPT",
        "EVENT",
        "BALANCE",
        "POSITION",
        "VALUATION",
        "OPERATOR",
        "CONFIG"
      ]
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "blockOrSequence": {
      "type": "string",
      "minLength": 1
    },
    "freshness": {
      "type": "string",
      "enum": [
        "FRESH",
        "STALE",
        "NOT_APPLICABLE"
      ]
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^(?:sha256|keccak256):[0-9a-f]{64}$"
    },
    "redactedRef": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "evidenceId",
    "kind",
    "sourceId",
    "observedAt",
    "freshness",
    "payloadHash"
  ],
  "additionalProperties": false,
  "$id": "https://virtual-risk.local/schema/legacy-v0.2-evidence-ref.v1.json"
}
