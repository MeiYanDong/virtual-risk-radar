{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1
    },
    "configVersion": {
      "type": "string",
      "minLength": 1
    },
    "effectiveAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "REPLAY",
        "SHADOW",
        "LIVE_READ_ONLY"
      ]
    },
    "economicEvidence": {
      "type": "string",
      "enum": [
        "POSITIVE_EV_NOT_PROVEN",
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "time": {
      "type": "object",
      "properties": {
        "internalTimezone": {
          "type": "string",
          "const": "UTC"
        },
        "uiTimezone": {
          "type": "string",
          "const": "Asia/Shanghai"
        },
        "maximumClockDriftMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "internalTimezone",
        "uiTimezone",
        "maximumClockDriftMs"
      ],
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "rawDays": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "decisionSnapshots": {
          "type": "string",
          "const": "LONG_TERM"
        },
        "cleanupMode": {
          "type": "string",
          "const": "DRY_RUN_ONLY"
        }
      },
      "required": [
        "rawDays",
        "decisionSnapshots",
        "cleanupMode"
      ],
      "additionalProperties": false
    },
    "tacticalSleeve": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "UNSET"
        },
        "scenariosPct": {
          "minItems": 3,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sellTranchesPct": {
          "minItems": 2,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rebuyTranchesPct": {
          "minItems": 2,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "state",
        "scenariosPct",
        "sellTranchesPct",
        "rebuyTranchesPct"
      ],
      "additionalProperties": false
    },
    "news": {
      "type": "object",
      "properties": {
        "authority": {
          "type": "string",
          "const": "AUXILIARY"
        },
        "marketOnlyPath": {
          "type": "string",
          "const": "ENABLED_STRICT"
        },
        "observationWindowSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "publicSourcesFirst": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "authority",
        "marketOnlyPath",
        "observationWindowSeconds",
        "publicSourcesFirst"
      ],
      "additionalProperties": false
    },
    "market": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "BTC"
            },
            {
              "type": "string",
              "const": "ETH"
            },
            {
              "type": "string",
              "const": "SOL"
            },
            {
              "type": "string",
              "const": "VIRTUAL"
            }
          ]
        },
        "sell": {
          "type": "object",
          "properties": {
            "fixedReturn60s": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": [
                  "BTC",
                  "ETH",
                  "SOL",
                  "VIRTUAL"
                ]
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "volatilityMultiplier": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": [
                  "BTC",
                  "ETH",
                  "SOL",
                  "VIRTUAL"
                ]
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "robustSigmaLookbackSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "marketArmBreadth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "broadMarketVolumeAnomalyMinimum": {
              "type": "string"
            },
            "virtualSellRatioMaximum": {
              "type": "string"
            },
            "virtualSellPersistenceSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "fixedReturn60s",
            "volatilityMultiplier",
            "robustSigmaLookbackSeconds",
            "marketArmBreadth",
            "broadMarketVolumeAnomalyMinimum",
            "virtualSellRatioMaximum",
            "virtualSellPersistenceSeconds"
          ],
          "additionalProperties": false
        },
        "rebuy": {
          "type": "object",
          "properties": {
            "noNewLowSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "oiContractsDeclineMinimumPct": {
              "type": "string"
            },
            "virtualBuySellRatioMinimum": {
              "type": "string"
            },
            "orderFlowPersistenceSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "btcReturn60sMinimum": {
              "type": "string"
            },
            "solReturn60sMinimum": {
              "type": "string"
            },
            "marketStabilitySeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "secondTrancheStabilitySeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "noNewLowSeconds",
            "oiContractsDeclineMinimumPct",
            "virtualBuySellRatioMinimum",
            "orderFlowPersistenceSeconds",
            "btcReturn60sMinimum",
            "solReturn60sMinimum",
            "marketStabilitySeconds",
            "secondTrancheStabilitySeconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "assets",
        "sell",
        "rebuy"
      ],
      "additionalProperties": false
    },
    "quoteLimits": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "UNSET"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "SET"
            },
            "maximumPriceImpactBps": {
              "type": "string"
            },
            "maximumRoundTripCostPct": {
              "type": "string"
            },
            "maximumGasSettlement": {
              "type": "string"
            }
          },
          "required": [
            "state",
            "maximumPriceImpactBps",
            "maximumRoundTripCostPct",
            "maximumGasSettlement"
          ],
          "additionalProperties": false
        }
      ]
    },
    "quoteResearch": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "FIXED_TEST_AMOUNTS"
        },
        "fixedSellAmountsVirtual": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "settlementAssetSymbol": {
          "type": "string",
          "const": "USDC"
        },
        "settlementAssetAddress": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "researchSlippageBps": {
          "type": "string"
        },
        "maximumCrossSourceDeviationBps": {
          "type": "string"
        },
        "quoteExpirySeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maximumBlockLag": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rpcEndpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https:\\/\\/.*"
        },
        "aggregatorProviderId": {
          "type": "string",
          "const": "velora-prices-v6.2"
        },
        "canonicalPoolProviderId": {
          "type": "string",
          "const": "uniswap-v3-direct-pool"
        },
        "canonicalPoolAddress": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "canonicalPoolFee": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "canonicalPoolFactoryAddress": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "canonicalQuoterAddress": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        }
      },
      "required": [
        "mode",
        "fixedSellAmountsVirtual",
        "settlementAssetSymbol",
        "settlementAssetAddress",
        "researchSlippageBps",
        "maximumCrossSourceDeviationBps",
        "quoteExpirySeconds",
        "maximumBlockLag",
        "rpcEndpoint",
        "aggregatorProviderId",
        "canonicalPoolProviderId",
        "canonicalPoolAddress",
        "canonicalPoolFee",
        "canonicalPoolFactoryAddress",
        "canonicalQuoterAddress"
      ],
      "additionalProperties": false
    },
    "chains": {
      "type": "object",
      "properties": {
        "base": {
          "type": "object",
          "properties": {
            "chainProfileId": {
              "type": "string",
              "minLength": 1
            },
            "networkScope": {
              "type": "string",
              "minLength": 1
            },
            "chainId": {
              "type": "string",
              "minLength": 1
            },
            "candidateVirtualTokenAddress": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "identityState": {
              "type": "string",
              "enum": [
                "UNVERIFIED",
                "UNKNOWN",
                "VERIFIED_CURRENT"
              ]
            },
            "quoteAdapterState": {
              "type": "string",
              "enum": [
                "PLANNED",
                "IMPLEMENTED",
                "UNSUPPORTED",
                "VERIFIED_CURRENT"
              ]
            }
          },
          "required": [
            "chainProfileId",
            "networkScope",
            "chainId",
            "identityState",
            "quoteAdapterState"
          ],
          "additionalProperties": false
        },
        "robinhood": {
          "type": "object",
          "properties": {
            "chainProfileId": {
              "type": "string",
              "minLength": 1
            },
            "networkScope": {
              "type": "string",
              "minLength": 1
            },
            "chainId": {
              "type": "string",
              "minLength": 1
            },
            "candidateVirtualTokenAddress": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "identityState": {
              "type": "string",
              "enum": [
                "UNVERIFIED",
                "UNKNOWN",
                "VERIFIED_CURRENT"
              ]
            },
            "quoteAdapterState": {
              "type": "string",
              "enum": [
                "PLANNED",
                "IMPLEMENTED",
                "UNSUPPORTED",
                "VERIFIED_CURRENT"
              ]
            }
          },
          "required": [
            "chainProfileId",
            "networkScope",
            "chainId",
            "identityState",
            "quoteAdapterState"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "base",
        "robinhood"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "modelVersion",
    "configVersion",
    "effectiveAt",
    "mode",
    "economicEvidence",
    "time",
    "retention",
    "tacticalSleeve",
    "news",
    "market",
    "quoteLimits",
    "quoteResearch",
    "chains"
  ],
  "additionalProperties": false,
  "$id": "https://virtual-risk.local/schema/legacy-v0.2-system-config.v1.json"
}
