{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "enum": [
        "SELL",
        "REBUY"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "NO_ACTION",
        "NEWS_ARMED",
        "MARKET_ARMED",
        "SELL_READY",
        "REBUY_WAIT",
        "REBUY_READY",
        "DATA_UNAVAILABLE",
        "UNKNOWN"
      ]
    },
    "output": {
      "type": "string",
      "enum": [
        "NO_ACTION",
        "WATCH",
        "SHADOW_CANDIDATE",
        "CEX_REFERENCE_READY"
      ]
    },
    "outputBasis": {
      "type": "string",
      "const": "CEX_REFERENCE"
    },
    "passed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "required": {
      "type": "number",
      "const": 4
    },
    "conditions": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "STALE"
            ]
          },
          "current": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "gap": {
            "type": "string",
            "minLength": 1
          },
          "progress": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "durationSeconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "techflow-public-newsletter",
              "binance-spot-public"
            ]
          },
          "dataAgeMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "label",
          "state",
          "current",
          "target",
          "gap",
          "progress",
          "durationSeconds",
          "source",
          "dataAgeMs",
          "reason",
          "evidenceIds"
        ],
        "additionalProperties": false
      }
    },
    "nextGap": {
      "type": "string",
      "minLength": 1
    },
    "extremeMarketFallback": {
      "type": "string",
      "enum": [
        "NOT_USED",
        "NOT_CALIBRATED",
        "UNKNOWN"
      ]
    },
    "sellContext": {
      "type": "string",
      "enum": [
        "NONE",
        "SHADOW_REFERENCE",
        "USER_RECORDED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "model",
    "stage",
    "output",
    "outputBasis",
    "passed",
    "required",
    "conditions",
    "nextGap",
    "extremeMarketFallback",
    "sellContext",
    "reason",
    "evidenceIds"
  ],
  "additionalProperties": false,
  "$id": "https://virtual-risk.local/schema/v3-decision-panel.v1.json"
}
