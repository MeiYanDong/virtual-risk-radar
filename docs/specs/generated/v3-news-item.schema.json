{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "observationId": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "const": "techflow-public-newsletter"
    },
    "sourceItemId": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "originalUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "bodyExcerpt": {
      "type": "string"
    },
    "sourceAttribution": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceOccurredAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "accessedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rawTextHash": {
      "type": "string",
      "pattern": "^(?:sha256|keccak256):[0-9a-f]{64}$"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "MONETARY_MACRO",
        "TRADE_SANCTIONS",
        "GEOPOLITICS",
        "FINANCIAL_STABILITY",
        "ENERGY_SUPPLY",
        "CRYPTO_POLICY",
        "OTHER",
        "UNKNOWN"
      ]
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "direction": {
      "type": "string",
      "enum": [
        "RISK_OFF",
        "RISK_ON",
        "NEUTRAL",
        "UNKNOWN"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "SYSTEMIC",
        "UNKNOWN"
      ]
    },
    "scheduledState": {
      "type": "string",
      "enum": [
        "SCHEDULED",
        "UNSCHEDULED",
        "UNKNOWN"
      ]
    },
    "macroRelevant": {
      "type": "boolean"
    },
    "classificationReason": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "3.0.0"
    }
  },
  "required": [
    "observationId",
    "sourceId",
    "sourceItemId",
    "sourceUrl",
    "originalUrl",
    "headline",
    "bodyExcerpt",
    "sourceAttribution",
    "categories",
    "sourceOccurredAt",
    "receivedAt",
    "accessedAt",
    "updatedAt",
    "revision",
    "rawTextHash",
    "eventType",
    "entities",
    "countries",
    "direction",
    "severity",
    "scheduledState",
    "macroRelevant",
    "classificationReason",
    "schemaVersion"
  ],
  "additionalProperties": false,
  "$id": "https://virtual-risk.local/schema/v3-news-item.v1.json"
}
