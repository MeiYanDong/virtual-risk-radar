{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceId": {
      "type": "string",
      "enum": [
        "techflow-public-newsletter",
        "binance-spot-public"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "NEWS",
        "MARKET"
      ]
    },
    "capabilityState": {
      "type": "string",
      "enum": [
        "PLANNED",
        "TESTED",
        "VERIFIED_CURRENT",
        "UNSUPPORTED"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "WARMING_UP",
        "HEALTHY",
        "DEGRADED",
        "STALE",
        "ERROR",
        "UNSUPPORTED"
      ]
    },
    "transport": {
      "type": "string",
      "enum": [
        "PUBLIC_WEBPAGE",
        "SPOT_WEBSOCKET"
      ]
    },
    "endpoint": {
      "type": "string",
      "minLength": 1
    },
    "lastAttemptAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastSuccessAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dataAgeMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "messagesReceived": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uniqueItems": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duplicates": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gaps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reconnects": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "sourceId",
    "label",
    "category",
    "capabilityState",
    "status",
    "transport",
    "endpoint",
    "lastAttemptAt",
    "lastSuccessAt",
    "dataAgeMs",
    "messagesReceived",
    "uniqueItems",
    "duplicates",
    "gaps",
    "reconnects",
    "errorCode",
    "reason",
    "evidenceIds"
  ],
  "additionalProperties": false,
  "$id": "https://virtual-risk.local/schema/v3-source-health.v1.json"
}
