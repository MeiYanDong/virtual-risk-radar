{
  "name": "virtual-risk-decision-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "start": "tsx apps/server/src/index.ts",
    "format": "biome format --write --no-errors-on-unmatched .",
    "format:check": "biome format --no-errors-on-unmatched .",
    "lint": "biome lint --no-errors-on-unmatched . && tsx scripts/check-readonly-boundaries.ts",
    "security:scan": "tsx scripts/check-readonly-boundaries.ts",
    "security:audit": "pnpm audit --audit-level high && .venv/bin/pip-audit . --progress-spinner off",
    "license:check": "tsx scripts/check-licenses.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:replay": "vitest run tests/replay",
    "test:coverage": "vitest run --coverage",
    "python:check": "sh scripts/check-python.sh",
    "schema:generate": "tsx scripts/generate-schemas.ts",
    "schema:check": "tsx scripts/check-schemas.ts",
    "deploy:check": "bash -n deploy/bootstrap-host.sh deploy/install-release.sh scripts/build-deployment-artifact.sh scripts/deploy-swas-release.sh && vitest run tests/unit/deployment-assets.test.ts",
    "deploy:artifact": "bash scripts/build-deployment-artifact.sh",
    "legacy:v0.2:fixture:capture:2026-08-22": "tsx scripts/capture-2026-08-22-fixture.ts",
    "legacy:v0.2:fixture:analyze:2026-08-22": "tsx scripts/analyze-2026-08-22-fixture.ts",
    "fixture:analyze:v3:2026-08-22": "tsx scripts/analyze-v3-2026-08-22.ts",
    "legacy:v0.2:fixture:news:2026-08-22": "tsx scripts/generate-2026-08-22-news-fixture.ts",
    "legacy:v0.2:fixture:verify:2026-08-22": "tsx scripts/verify-2026-08-22-fixture.ts",
    "legacy:v0.2:chain:verify:base": "tsx scripts/verify-base-identity.ts",
    "legacy:v0.2:quote:verify:base": "tsx scripts/verify-base-quote-research.ts",
    "legacy:v0.2:quote:soak:base": "tsx scripts/soak-base-quotes.ts",
    "shadow:report:v3": "tsx scripts/report-v3-shadow.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "pnpm typecheck && pnpm build:web",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm schema:check && pnpm deploy:check && pnpm legacy:v0.2:fixture:verify:2026-08-22 && pnpm test:coverage && pnpm python:check && pnpm security:audit && pnpm license:check && pnpm build:web && pnpm security:scan",
    "ci": "pnpm check"
  },
  "dependencies": {
    "@fastify/cors": "10.1.0",
    "decimal.js": "10.6.0",
    "fastify": "5.12.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.20.5",
    "viem": "2.55.19",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
